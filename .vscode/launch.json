{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Express",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/src/app.ts",
      "runtimeArgs": ["--nolazy", "-r", "ts-node/register"],
      "env": { "DEBUG": "express:*" },
      "console": "integratedTerminal"
    }
  ]
}
